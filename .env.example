DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# This file documents variables; loading instructions are in README.md.
# Required before external deployment:
# DJANGO_SECRET_KEY=<generate a unique value locally>
# DATABASE_URL=postgresql://sparkx:<local-password>@127.0.0.1:5432/sparkx
# Configure OPENAI_API_KEY securely; never commit it.
OPENAI_MODEL=gpt-6-luna
AI_DAILY_JOB_LIMIT=20
AI_MAX_PENDING_PER_EVENT=3
AI_MAX_OUTPUT_TOKENS=2500

# Solo tras proxy confiable que sanee X-Forwarded-Proto
DJANGO_TRUST_PROXY=0

# Optional multi-provider credentials: set only in the private server environment.
# GROQ_API_KEY=
# Optional synthetic free bridge; DEBUG must also be enabled, with an explicit profile.
# SPARKX_FREE_DEMO_ENABLED=1
# GEMINI_API_KEY=
# Local Ollama only; install and validate capacity first.
OLLAMA_ENABLED=0
# Herramienta interna temporal: activa por defecto sólo con DJANGO_DEBUG=1.
# SPARKX_CHECKLIST_ENABLED=0
# Private owner of this temporary module; other administrators cannot open it.
SPARKX_CHECKLIST_OWNER_USERNAME=adminjorge
# Select a profile and budget in /ai/. No paid use is enabled automatically.
